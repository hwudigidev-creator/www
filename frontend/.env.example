# Google Apps Script Web App URL (主要 API)
# 用於取得首頁、產品、關於頁面資料
VITE_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# 聯絡表單專用 Google Apps Script URL
# 設定此變數後，聯絡表單會直接寫入 Google Sheets
# 請參考 README.md 的「聯絡表單 API」章節設定
VITE_CONTACT_API_URL=https://script.google.com/macros/s/YOUR_CONTACT_FORM_DEPLOYMENT_ID/exec
